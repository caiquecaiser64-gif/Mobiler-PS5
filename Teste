<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#050a18">
<meta name="mobile-web-app-capable" content="yes">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="assets/icons/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="assets/icons/icon.svg">
<title>Mobile PS5</title>
<link rel="stylesheet" href="css/style.css">
<link rel="stylesheet" href="css/loading.css">
<link rel="stylesheet" href="css/home.css">
<link rel="stylesheet" href="css/controller.css">
</head>
<body>
<div id="app">

  <!-- 1. Controles -->
  <section id="screen-controller" class="screen">
    <div class="logo"><span class="logo-mark">5</span><span>Mobile <b>PS5</b></span></div>
    <p class="muted center small">Controle virtual: toque nos botões e arraste os analógicos para testar.</p>
    <div class="padwrap"><div id="pad-intro"></div></div>
    <div id="pad-readout" class="readout">Nenhum botão pressionado</div>
    <button id="btn-continue" class="btn primary big">Continuar</button>
  </section>

  <!-- 2. Carregamento -->
  <section id="screen-loading" class="screen center-col">
    <div class="orb"><div class="ring"></div><div class="ring r2"></div><div id="load-pct">0%</div></div>
    <div class="logo"><span class="logo-mark">5</span><span>Mobile <b>PS5</b></span></div>
    <div id="load-msg" class="load-msg">Inicializando Mobile PS5...</div>
    <div class="bar"><i id="load-bar"></i></div>
    <ul id="load-log" class="load-log"></ul>
  </section>

  <!-- 3. Usuário -->
  <section id="screen-user" class="screen center-col">
    <div class="logo big"><span class="logo-mark">5</span><span>Mobile <b>PS5</b></span></div>
    <h1>Bem-vindo ao Mobile PS5</h1>
    <form id="user-form" autocomplete="off" style="width:100%;max-width:380px">
      <label for="user-name">Nome de usuário</label>
      <input id="user-name" maxlength="16" placeholder="Digite seu nome" required>
      <label>Avatar</label>
      <div id="avatar-pick" class="avatars"></div>
      <div id="user-err" class="err"></div>
      <button class="btn primary big" type="submit">OK</button>
    </form>
  </section>

  <!-- 4. Home / 5. Biblioteca / 6. Detalhe / 7. Configurações -->
  <section id="screen-home" class="screen"></section>

  <section id="screen-library" class="screen">
    <div class="topbar"><button class="icon-btn" data-action="back" aria-label="Voltar">‹</button><h2>Biblioteca</h2></div>
    <input id="lib-search" type="search" placeholder="Buscar jogo ou gênero">
    <p class="muted small">Jogos de exemplo. A execução depende de uma integração de streaming que ainda não está conectada.</p>
    <div id="lib-grid" class="grid"></div>
  </section>

  <section id="screen-game" class="screen"></section>
  <section id="screen-settings" class="screen"></section>

  <!-- 8. Streaming -->
  <section id="screen-stream" class="screen">
    <div class="hud">
      <button id="st-back" class="icon-btn" aria-label="Voltar">‹</button>
      <div class="hud-title" id="st-title">Jogo</div>
      <div class="hud-stat"><i id="st-dot" class="dot"></i><span id="st-conn">Desconectado</span></div>
      <div class="hud-stat" id="st-quality">—</div>
      <button id="st-pad" class="icon-btn" aria-label="Mostrar ou ocultar controles" style="font-size:.8rem">🎮</button>
    </div>
    <div class="video">
      <video id="st-video" playsinline muted></video>
      <div id="st-overlay" class="overlay"></div>
    </div>
    <div id="st-padwrap" class="stream-pad"><div class="padwrap"><div id="pad-stream"></div></div></div>
  </section>
</div>

<div id="sheet" class="sheet">
  <div class="sheet-card">
    <div class="sheet-head"><h3 id="sheet-title"></h3><button class="icon-btn" data-action="close-sheet" aria-label="Fechar">✕</button></div>
    <div id="sheet-body"></div>
  </div>
</div>
<div id="toast" class="toast"></div>

<script src="js/app.js"></script>
<script src="js/device-analysis.js"></script>
<script src="js/user.js"></script>
<script src="js/library.js"></script>
<script src="js/controller.js"></script>
<script src="js/settings.js"></script>
<script src="js/streaming.js"></script>
<script src="js/loading.js"></script>
</body>
</html>
